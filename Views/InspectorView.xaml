<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AdventureMapper.Views.InspectorView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:AdventureMapper.Resources.Strings"
    BackgroundColor="#FFFFFF">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Style="{StaticResource SectionHeading}" Text="{loc:Translate Inspector_Map}" />
            <Entry
                x:Name="MapTitleEntry"
                Placeholder="{loc:Translate Inspector_TitlePlaceholder}"
                Style="{StaticResource FieldEntry}"
                TextChanged="OnMapTitleChanged" />
            <Entry
                x:Name="MapAuthorEntry"
                Placeholder="{loc:Translate Inspector_AuthorPlaceholder}"
                Style="{StaticResource FieldEntry}"
                TextChanged="OnMapAuthorChanged" />

            <BoxView HeightRequest="1" Color="#D9E0EA" />

            <Label Style="{StaticResource SectionHeading}" Text="{loc:Translate Inspector_Layers}" />
            <Picker
                x:Name="LayerPicker"
                ItemDisplayBinding="{Binding Display}"
                Style="{StaticResource FieldPicker}"
                Title="{loc:Translate Inspector_FloorPlaceholder}"
                SelectedIndexChanged="OnLayerPicked" />
            <Entry
                x:Name="LayerNameEntry"
                Placeholder="{loc:Translate Inspector_LayerNamePlaceholder}"
                Style="{StaticResource FieldEntry}"
                TextChanged="OnLayerNameChanged" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Clicked="OnFloorAboveClicked" Style="{StaticResource ToolbarButton}" Text="{loc:Translate Inspector_FloorAbove}" />
                <Button
                    Grid.Column="1"
                    Clicked="OnFloorBelowClicked"
                    Style="{StaticResource ToolbarButton}"
                    Text="{loc:Translate Inspector_FloorBelow}" />
            </Grid>
            <Label x:Name="LayerSummaryLabel" Style="{StaticResource Caption}" />

            <BoxView HeightRequest="1" Color="#D9E0EA" />

            <Label Style="{StaticResource SectionHeading}" Text="{loc:Translate Inspector_Room}" />
            <Label
                x:Name="NoRoomLabel"
                Style="{StaticResource Caption}"
                Text="{loc:Translate Inspector_NoRoom}" />

            <VerticalStackLayout x:Name="RoomSection" IsVisible="False" Spacing="10">
                <Label x:Name="RoomHeadingLabel" Style="{StaticResource Caption}" />
                <Entry
                    x:Name="RoomNameEntry"
                    Placeholder="{loc:Translate Inspector_RoomNamePlaceholder}"
                    Style="{StaticResource FieldEntry}"
                    TextChanged="OnRoomNameChanged" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label
                        x:Name="DescriptionPreviewLabel"
                        MaxLines="3"
                        Style="{StaticResource Caption}"
                        LineBreakMode="TailTruncation"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Clicked="OnEditDescriptionClicked"
                        Style="{StaticResource ToolbarButton}"
                        Text="{loc:Translate Inspector_EditDescription}" />
                </Grid>

                <Picker
                    x:Name="RoomKindPicker"
                    Style="{StaticResource FieldPicker}"
                    Title="{loc:Translate Inspector_RoomTypePlaceholder}"
                    SelectedIndexChanged="OnRoomKindChanged" />

                <HorizontalStackLayout Spacing="8">
                    <Switch x:Name="HiddenSwitch" Toggled="OnHiddenToggled" />
                    <Label
                        Style="{StaticResource Caption}"
                        Text="{loc:Translate Inspector_HiddenRoom}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Style="{StaticResource Caption}" Text="{loc:Translate Inspector_HiddenHint}" />

                <VerticalStackLayout x:Name="BridgeSection" IsVisible="False" Spacing="8">
                    <Label Style="{StaticResource Caption}" Text="{loc:Translate Inspector_BridgeHint}" />
                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                        <Entry
                            x:Name="BridgeLayerEntry"
                            Keyboard="Numeric"
                            Placeholder="{loc:Translate Inspector_BridgeLayerPlaceholder}"
                            Style="{StaticResource FieldEntry}"
                            TextChanged="OnBridgeLayerChanged" />
                        <Picker
                            x:Name="BridgeRoomPicker"
                            Grid.Column="1"
                            ItemDisplayBinding="{Binding Display}"
                            Style="{StaticResource FieldPicker}"
                            Title="{loc:Translate Inspector_BridgeRoomPlaceholder}"
                            SelectedIndexChanged="OnBridgeRoomPicked" />
                    </Grid>
                </VerticalStackLayout>

                <Label Style="{StaticResource Caption}" Text="{loc:Translate Inspector_ConnectionsHint}" />
                <VerticalStackLayout x:Name="ConnectionsContainer" Spacing="4" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <Picker
                        x:Name="ConnectionDirectionPicker"
                        Style="{StaticResource FieldPicker}"
                        WidthRequest="132" />
                    <Entry
                        x:Name="ConnectionReferenceEntry"
                        Grid.Column="1"
                        Placeholder="{loc:Translate Inspector_TargetPlaceholder}"
                        Style="{StaticResource FieldEntry}" />
                    <Button
                        Grid.Column="2"
                        Clicked="OnAddConnectionClicked"
                        Style="{StaticResource ToolbarButton}"
                        Text="{loc:Translate Common_Add}" />
                </Grid>

                <Label Style="{StaticResource Caption}" Text="{loc:Translate Inspector_Puzzles}" />
                <VerticalStackLayout x:Name="PuzzlesContainer" Spacing="4" />
                <Button Clicked="OnAddPuzzleClicked" Style="{StaticResource AccentButton}" Text="{loc:Translate Inspector_AddPuzzle}" />

                <Button Clicked="OnDeleteRoomClicked" Style="{StaticResource DangerButton}" Text="{loc:Translate Inspector_DeleteRoom}" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#D9E0EA" />

            <Label Style="{StaticResource SectionHeading}" Text="{loc:Translate Inspector_AutoSave}" />
            <Picker x:Name="AutoSavePicker" Style="{StaticResource FieldPicker}" Title="{loc:Translate Inspector_IntervalPlaceholder}" SelectedIndexChanged="OnAutoSaveIntervalChanged" />
            <Label x:Name="AutoSaveStatusLabel" Style="{StaticResource Caption}" />
            <Button Clicked="OnSaveNowClicked" Style="{StaticResource ToolbarButton}" Text="{loc:Translate Inspector_SaveNow}" />

            <BoxView HeightRequest="1" Color="#D9E0EA" />

            <Label Style="{StaticResource SectionHeading}" Text="{loc:Translate Inspector_Checks}" />
            <VerticalStackLayout x:Name="WarningsContainer" Spacing="4" />

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
